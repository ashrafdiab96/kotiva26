{#
  KOTIVA product page — the reference's resources/views/product/show.blade.php, fed by Salla.
  Markup lives in components/kotiva/pdp.twig (it needs the generated catalog + copy data).

  Salla supplies: name, price, stock, images, the add-to-cart form and reviews. The KOTIVA
  metadata (category, skin type, concern, related products) comes from the SKU map; the
  editorial copy comes from product.description when it follows the reference format, else
  from the reference copy (pdp.js). See docs/DECISIONS.md T-09.

  Variables: see the Raed header this replaced — product.* (id, name, description, url, sku,
  price, sale_price, regular_price, is_on_sale, is_out_of_stock, status, type, quantity,
  max_quantity, image, images, category, options, notify_availability, can_quick_buy, …).
#}
{% extends "layouts.master" %}

{% block content %}
    {% include 'components.kotiva.data' with {
        kotiva_view: 'components.kotiva.copy',
        kotiva_copy_view: 'components.kotiva.pdp'
    } %}
{% endblock %}

{% block scripts %}
    <script>window.KOTIVA_THEME.taxInclusivePrices = {{ (store.settings.tax.taxable_prices_enabled ?? false) ? 'true' : 'false' }};</script>
    <script src="{{ 'kotiva-pdp.js'|asset }}"></script>
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
