{#
  Every Salla product listing renders here: /latest-products (the KOTIVA "Shop" link — Salla
  has no all-products URL), categories, tags, offers and search.

  /latest-products is the KOTIVA collection (the reference's shop page). The other sources
  reuse the same hero, sort row and card, fed from that source by kotiva-listing.js; the
  filter row is dropped there because a category or search result is already a filter.
  See docs/DECISIONS.md T-08.

| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | product.index.latest, product.index (category), .tag, .offers, .search |
| page.id                    | ?int        | category / tag id                                                    |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}

{% block content %}
    {% include 'components.kotiva.data' with {
        kotiva_view: 'components.kotiva.listing',
        kotiva_listing_mode: page.slug == 'product.index.latest' ? 'collection' : 'source'
    } %}
{% endblock %}

{% block scripts %}
    <script>
      window.KOTIVA_THEME.taxInclusivePrices = {{ (store.settings.tax.taxable_prices_enabled ?? false) ? 'true' : 'false' }};
      window.KOTIVA_THEME.searchQuery = {{ (search_query ?? '')|json_encode|raw }};
    </script>
    <script src="{{ 'kotiva-listing.js'|asset }}"></script>
{% endblock %}
