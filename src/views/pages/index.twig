{#
  KOTIVA home — the reference's pages/home.blade.php, one Salla home component per section
  (components/home/kotiva-*.twig, registered in twilight.json with is_default so a fresh
  install shows them in the reference order).

| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "index"                                                         |
#}
{% extends "layouts.master" %}

{% block head_scripts %}
    {# The reference linked to "<store>/?filter=…" and "<store>/?routine=…". The store root is
       this home page, so forward those to the listing before anything paints. #}
    <script data-cfasync="false">(function(){var q=location.search;if(/[?&](filter|routine)=/.test(q)){location.replace({{ theme.settings.get('kotiva_url_shop')|json_encode|raw }}+q);}})();</script>
    <link rel="preload" as="image" href="{{ theme.settings.get('hero_1_desktop') ?: 'kotiva/img/hero/1.jpeg'|asset }}" media="(min-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="{{ theme.settings.get('hero_1_mobile') ?: 'kotiva/img/hero/3.jpeg'|asset }}" media="(max-width: 767px)" fetchpriority="high" />
{% endblock %}

{% block main_attrs %} aria-label="Main content"{% endblock %}

{% block content %}
    {% component home %}
{% endblock %}
