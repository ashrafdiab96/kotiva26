{#
  KOTIVA home — the reference's pages/home.blade.php. The twelve sections
  (components/home/kotiva-*.twig) are included directly in the reference order, not through
  the home component tag, so the theme editor cannot reorder or hide them (T-20). They read
  theme.settings only, never a `component` variable.

| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "index"                                                         |
#}
{% extends "layouts.master" %}

{% block head_scripts %}
    {# The reference linked to "<store>/?filter=…" and "<store>/?routine=…". The store root is
       this home page, so forward those to the listing before anything paints. #}
    <script data-cfasync="false">(function(){var q=location.search;if(/[?&](filter|routine)=/.test(q)){location.replace({{ theme.settings.get('kotiva_url_shop')|json_encode|raw }}+q);}})();</script>
    <link rel="preload" as="image" href="{{ theme.settings.get('hero_1_desktop') ?: 'kotiva/img/hero/1.jpeg'|asset }}" media="(min-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="{{ theme.settings.get('hero_1_mobile') ?: 'kotiva/img/hero/3.jpeg'|asset }}" media="(max-width: 767px)" fetchpriority="high" />
{% endblock %}

{% block main_attrs %} aria-label="Main content"{% endblock %}

{% block content %}
    {% include "components.home.kotiva-hero" %}
    {% include "components.home.kotiva-marquee" %}
    {% include "components.home.kotiva-credentials" %}
    {% include "components.home.kotiva-philosophy" %}
    {% include "components.home.kotiva-categories" %}
    {% include "components.home.kotiva-doctor" %}
    {% include "components.home.kotiva-routine-cta" %}
    {% include "components.home.kotiva-bestsellers" %}
    {% include "components.home.kotiva-ingredients" %}
    {% include "components.home.kotiva-standard" %}
    {% include "components.home.kotiva-ritual" %}
    {% include "components.home.kotiva-newsletter" %}
{% endblock %}
