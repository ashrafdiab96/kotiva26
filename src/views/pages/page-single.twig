{#
  Salla pages → KOTIVA pages.

  Salla gives every merchant page the same page.slug ("page-single") and a URL built from its
  title (/<title-slug>/page-<id>), so the brief's dispatch-by-slug cannot work as written.
  A page is recognised as KOTIVA page <key> by, in order:
    1. its id matching Theme settings → "KOTIVA pages" (kotiva_page_<key>; the same
       setting the nav links use), or
    2. its content being the marker  kotiva:<key>  (e.g. kotiva:routine-finder), or
    3. a URL segment equal to the key's slug (a page titled "Routine Finder" lives at
       /routine-finder/page-<id>).
  It then renders pages/kotiva/<slug>.twig (+ <slug>-pre-scripts / <slug>-scripts, the
  reference's @push('pre_scripts') / @push('scripts'), when they exist). Any other page falls
  back to Raed's generic rendering inside the KOTIVA chrome. See docs/DECISIONS.md T-05.

| Variable     | Type   | Description |
|--------------|--------|-------------|
| page         | Page   | id, title, content, url, slug ("page-single"), type |
#}
{% extends "layouts.master" %}

{% set kotiva_keys = {
  about: 'about', science: 'science', contact: 'contact', ingredients: 'ingredients',
  routine_finder: 'routine-finder', privacy_policy: 'privacy-policy', terms: 'terms'
} %}
{% set kotiva_page = null %}
{% set marker = (page.content ?? '')|striptags|trim|lower|replace({'[': '', ']': '', ' ': ''}) %}
{% set url_parts = (page.url ?? '')|split('?')|first|split('/') %}
{% for key, slug in kotiva_keys %}
  {% set configured = (theme.settings.get('kotiva_page_' ~ key) ?? '')|trim %}
  {% if not kotiva_page and configured != '' and (configured == (page.id ~ '') or configured ends with ('/page-' ~ page.id) or configured ends with ('/page-' ~ page.id ~ '/')) %}
    {% set kotiva_page = slug %}
  {% endif %}
{% endfor %}
{% if not kotiva_page %}
  {% for key, slug in kotiva_keys %}
    {% if not kotiva_page and (marker == 'kotiva:' ~ slug or marker == 'kotiva:' ~ key) %}{% set kotiva_page = slug %}{% endif %}
  {% endfor %}
{% endif %}
{% if not kotiva_page %}
  {% for key, slug in kotiva_keys %}
    {% if not kotiva_page and slug in url_parts %}{% set kotiva_page = slug %}{% endif %}
  {% endfor %}
{% endif %}

{% block body_class %}{{ kotiva_page ? '' : 'kotiva-raed' }}{% endblock %}
{% block body_attrs %}{% if kotiva_page %} data-kotiva-page="{{ kotiva_page }}"{% endif %}{% endblock %}

{% block pre_scripts %}
  {% if kotiva_page %}{% include 'pages.kotiva.' ~ kotiva_page ~ '-pre-scripts' ignore missing %}{% endif %}
{% endblock %}

{% block content %}
  {% if kotiva_page %}
    {% include 'pages.kotiva.' ~ kotiva_page %}
  {% elseif page.type == 'customised' %}
    <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
  {% else %}
    {% include 'pages.partials.raed-page' %}
  {% endif %}
{% endblock %}

{% block scripts %}
  {% if kotiva_page %}{% include 'pages.kotiva.' ~ kotiva_page ~ '-scripts' ignore missing %}{% endif %}
{% endblock %}
