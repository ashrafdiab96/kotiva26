{#
  KOTIVA journal article (a Salla blog post). The reference had no article page — its journal
  was teasers only — so this reuses the reference's own long-form layout (the legal pages'
  hero + .legal-content column, components/kotiva/article.twig) rather than inventing one.

| Variable                | Type           | Description |
|-------------------------|----------------|-------------|
| article.title           | string         |             |
| article.body            | string *HTML   |             |
| article.image           | object         | url, alt    |
| article.has_image       | bool           |             |
| article.created_at      | ?Date          |             |
| article.author.name     | string         |             |
| article.tags[]          | BlogTag[]      | name, url   |
#}
{% extends "layouts.master" %}

{% block content %}
  {% include 'components.kotiva.article' with {
    eyebrow: article.tags|length ? (article.tags|first).name : 'The Kotiva Journal',
    title: article.title,
    meta: (article.created_at ? article.created_at|date('j F Y') : '') ~ ((article.author.name ?? '') != '' ? ' · ' ~ article.author.name : ''),
    image: article.has_image ? article.image.url : null,
    body: article.body,
    back_url: theme.settings.get('kotiva_url_journal'),
    back_label: 'Back to the Journal'
  } %}
{% endblock %}
