{#
  KOTIVA Journal (/blog) — the reference's resources/views/pages/journal.blade.php
  (pages/kotiva/journal*.twig), on Salla's blog.

  The reference journal is six "Coming soon" teasers from data-lite.js — that is the KOTIVA
  journal's empty state, and it renders unchanged while the store has no blog posts. Once the
  client publishes Salla blog posts, they replace the teasers in the same layout (feature +
  grid, newest first) and link to the posts. A post's first tag is its category, so tagging
  posts Ingredients / Routines / Dermatology / Education / Brand makes the topic filter work.
  See docs/DECISIONS.md T-11.

| Variable                | Type          | Description                 |
|-------------------------|---------------|-----------------------------|
| page                    | object        |                             |
| articles                | Article[]     | title, url, summary, image.url, has_image, created_at, tags[] |
| categories              | BlogCategory[]|                             |
#}
{% extends "layouts.master" %}

{% block pre_scripts %}
  {% include 'pages.kotiva.journal-pre-scripts' %}
  {% if articles|length %}
    {% set rows = [] %}
    {% for article in articles %}
      {% set rows = rows|merge([{
        id: article.id ?? loop.index,
        category: (article.tags|length ? (article.tags|first).name : 'Journal')|e,
        title: article.title|e,
        date: article.created_at ? article.created_at|date('F j, Y') : '',
        image: article.has_image ? article.image.url : '',
        read: '',
        excerpt: (article.summary ?? '')|striptags|e,
        url: article.url
      }]) %}
    {% endfor %}
    <script>
      /* Salla blog posts take the place of the reference's teaser articles. */
      window.KOTIVA.journal = window.KOTIVA.articles = {{ rows|json_encode|raw }};
    </script>
  {% endif %}
{% endblock %}

{% block content %}
  {% include 'pages.kotiva.journal' %}
{% endblock %}

{% block scripts %}
  {% include 'pages.kotiva.journal-scripts' %}
{% endblock %}
