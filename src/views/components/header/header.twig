{#
  KOTIVA navigation + mobile overlay — the reference layout's markup verbatim, with:
    • hrefs from components/kotiva/urls.twig (Salla URLs, never a hostname);
    • the cart control carrying a live count (the reference store held no cart, so its badge
      was never rendered; Salla's cart is real). The count uses Raed's own [data-cart-count]
      hook, which app.js updates on every salla cart event, and kotiva-core.js toggles
      .is-empty — the badge styles already exist in the verbatim shop.css.
  layout.js drives everything else (scroll state, logo swap, theme toggle, focus trap).

| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
#}
{% set u = {
  home: theme.settings.get('kotiva_url_home'),
  shop: theme.settings.get('kotiva_url_shop'),
  science: theme.settings.get('kotiva_url_science'),
  journal: theme.settings.get('kotiva_url_journal'),
  about: theme.settings.get('kotiva_url_about'),
  buy: theme.settings.get('kotiva_url_where_to_buy'),
  routine: theme.settings.get('kotiva_url_routine_finder'),
  cart: theme.settings.get('kotiva_url_cart')
} %}
{% set cart_count = cart.items_count ?? 0 %}
<nav class="nav transparent" id="main-nav" role="navigation" data-testid="store-header">
  <div class="nav-inner">
    <a class="nav-logo" href="{{ u.home }}" data-kotiva-nav="home" aria-label="KOTIVA Home">
      <img class="logo-dark" src="{{ 'kotiva/assets/kotiva-logo.svg'|asset }}" alt="KOTIVA" height="28" />
      <img class="logo-light" src="{{ 'kotiva/assets/kotiva-logo-white.svg'|asset }}" alt="KOTIVA" height="28" style="display:none;" />
    </a>
    <div class="nav-links" role="list">
      <a class="nav-link" href="{{ u.home }}" data-kotiva-nav="home" role="listitem">Home</a>
      <a class="nav-link" href="{{ u.shop }}" data-kotiva-nav="shop" role="listitem">Shop</a>
      <a class="nav-link" href="{{ u.science }}" data-kotiva-nav="science" role="listitem">Science</a>
      <a class="nav-link" href="{{ u.journal }}" data-kotiva-nav="journal" role="listitem">Journal</a>
      <a class="nav-link" href="{{ u.about }}" data-kotiva-nav="about" role="listitem">About</a>
      <a class="nav-link" href="{{ u.buy }}" data-kotiva-nav="where_to_buy" role="listitem">Where to Buy</a>
    </div>
    <div class="nav-right">
      <a class="btn btn-gold btn-sm" href="{{ u.routine }}" data-kotiva-nav="routine_finder">Find My Routine</a>
      <a class="nav-cart" href="{{ u.cart }}" aria-label="Open cart" data-testid="store-header-cart">
        <span class="nav-cart-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </span>
        <span class="nav-cart-badge{{ cart_count > 0 ? '' : ' is-empty' }}" data-cart-count aria-hidden="true">{{ cart_count }}</span>
      </a>
      <button class="nav-theme-btn" id="theme-toggle" aria-label="Switch to dark mode" title="Toggle light/dark">
        <span class="icon-moon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg></span>
        <span class="icon-sun" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></span>
      </button>
      <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Overlay -->
<div class="nav-overlay" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <a class="nav-link" href="{{ u.home }}" data-kotiva-nav="home">Home</a>
  <a class="nav-link" href="{{ u.shop }}" data-kotiva-nav="shop">Shop</a>
  <a class="nav-link" href="{{ u.science }}" data-kotiva-nav="science">Science</a>
  <a class="nav-link" href="{{ u.journal }}" data-kotiva-nav="journal">Journal</a>
  <a class="nav-link" href="{{ u.about }}" data-kotiva-nav="about">About</a>
  <a class="nav-link" href="{{ u.buy }}" data-kotiva-nav="where_to_buy">Where to Buy</a>
  <a class="btn btn-gold" href="{{ u.routine }}" data-kotiva-nav="routine_finder">Find My Routine</a>
</div>
