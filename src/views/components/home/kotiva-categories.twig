      </div>
      <div class="category-card-overlay"></div>
      <div class="category-card-info">
        <div class="category-card-name">Body</div>
        <div class="category-card-count">8 products</div>
      </div>
      <div class="category-card-arrow" aria-hidden="true">→</div>
    </a>

