      <span class="credential-badge">Dermatologist-Approved</span>
      <span class="credential-badge">Doctor-Approved</span>
    </div>
    <a class="btn btn-gold" href="{{ theme.settings.get('kotiva_url_science') }}">Our Science →</a>
  </div>
  <div class="doctor-image" style="position:relative;overflow:hidden;">
    <img src="{{ 'kotiva/assets/home-doctor-approved-v5.webp'|asset }}" alt="A dermatologist in a white coat holding the real KOTIVA Micellar Water bottle, label clearly visible" loading="lazy" data-parallax="0.10" style="position:absolute;top:-7%;left:0;width:100%;height:114%;object-fit:cover;object-position:center 22%;" />
  </div>
